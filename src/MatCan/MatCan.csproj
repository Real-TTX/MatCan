<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MatCan</RootNamespace>
    <AssemblyName>MatCan</AssemblyName>
    <UserSecretsId>matcan</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Draws the QR code of the authenticator app set-up as SVG (pure managed, no external service) -->
    <PackageReference Include="QRCoder" Version="1.*" />
    <!-- SMTP for the mails of the platform (invitations, shares, requests, mentions): Services/Mail -->
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- The text of attachments of the AI chat (Logic/AiAttachmentLogic): PDF pages (PdfPig, Apache-2.0, the maintained successor of UglyToad.PdfPig) and Word / Excel files (Open XML SDK, MIT) -->
    <PackageReference Include="PdfPig" Version="0.1.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatCan.Core\MatCan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Demo\kaesetheke.json" LogicalName="MatCan.Demo.kaesetheke.json" />
    <!-- The built-in templates (Services/TemplateSeeder): one file per template, written by tools/templates-build.js -->
    <EmbeddedResource Include="Demo\templates\*.json" LogicalName="MatCan.Demo.templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatCan.Tests" />
  </ItemGroup>

</Project>
