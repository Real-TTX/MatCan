@page
@model MatCan.Pages.Account.LoginModel
@{
    Layout = "_Bare";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>MatCan</h1>
        <p class="mat-muted">Anmelden</p>
    </div>

    <partial name="_LoginForm" model="Model" />
    @if (Model.RegistrationOpen)
    {
        <p class="mat-hint dt-auth__alt">Noch kein Konto? <a href="/Account/Register" data-register-link>Konto erstellen</a></p>
    }
</div>
