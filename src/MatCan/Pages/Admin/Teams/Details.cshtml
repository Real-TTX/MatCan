@page
@model MatCan.Pages.Admin.Teams.DetailsModel
@{
    var t = Model.Team;
}

<dt-card title="@t.Team.Name" icon="users" sub="@Ui.Plural(t.Team.MemberCount, "Mitglied", "Mitglieder")">
    @if (!string.IsNullOrWhiteSpace(t.Description))
    {
        <p>@t.Description</p>
    }
    <dl class="mat-kv">
        <dt>Adresse</dt><dd class="mat-mono">/Teams/@t.Team.Slug</dd>
        <dt>Erstellt</dt><dd>@Fmt.Moment(t.Team.Created)</dd>
        <dt>Speicherplatz</dt><dd>@Fmt.FileSize(t.Storage.UsedBytes) von @Fmt.FileSize(t.Storage.QuotaBytes)</dd>
    </dl>
    <p class="mat-hint">Als Administrator siehst du, wer im Team ist und wie viel Platz es braucht, aber nicht, was es enthält. Zum Helfen kannst du dem Team als Admin beitreten; das Team sieht dich dann in der Mitgliederliste und der Beitritt steht im Protokoll.</p>
    <form method="post" class="mat-actions">
        @if (t.IAmMember)
        {
            <a class="mat-btn mat-btn--primary" href="/Teams/@t.Team.Slug/Projekte">@Ui.Icon("folder")<span>Team öffnen</span></a>
            <span class="mat-hint">Du bist schon Mitglied.</span>
        }
        else
        {
            <button type="submit" asp-page-handler="Join" asp-route-id="@Model.Id" class="mat-btn mat-btn--primary" data-confirm="Dem Team als Admin beitreten, um zu helfen? Das Team sieht dich in der Mitgliederliste, der Beitritt wird protokolliert." data-confirm-ok="Beitreten">@Ui.Icon("login")<span>Mir beitreten (Support)</span></button>
        }
    </form>
</dt-card>

<dt-card title="Mitglieder" icon="users">
    <div class="mat-table-wrap">
        <table class="mat-table" id="admin-team-members">
            <caption class="mat-sr-only">Mitglieder des Teams</caption>
            <thead><tr><th scope="col">Name</th><th scope="col">Rolle</th><th scope="col" class="mat-hide-sm">Dabei seit</th></tr></thead>
            <tbody>
                @foreach (var m in t.Members)
                {
                    <tr>
                        <td data-label="Name">@Ui.Person(m.DisplayName)<small class="mat-muted dt-sub">@m.Email</small></td>
                        <td data-label="Rolle">@Ui.Pill(Labels.Of(m.Role), m.Role == SpaceRole.Owner ? "accent" : "plain")</td>
                        <td data-label="Dabei seit" class="mat-hide-sm">@Fmt.Date(m.Since)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</dt-card>

<dt-card title="Speicherplatz" icon="hard-drive">
    <form class="mat-form" method="post" asp-page-handler="Quota" asp-route-id="@Model.Id">
        <div class="mat-form__grid">
            <div class="mat-field">
                <label class="mat-label" for="QuotaMb">Grenze in MB</label>
                <input class="mat-input" type="number" id="QuotaMb" name="QuotaMb" min="1" step="1" inputmode="numeric" value="@Model.QuotaMb" placeholder="Standard" />
                <span class="mat-hint">Leer lassen für den Standard der Plattform.</span>
            </div>
        </div>
        <div class="mat-actions"><button type="submit" class="mat-btn mat-btn--secondary">@Ui.Icon("save")<span>Grenze speichern</span></button></div>
    </form>
</dt-card>

<div class="mat-btn-row"><a class="mat-btn mat-btn--secondary" href="/Admin/Teams">@Ui.Icon("back")<span>Zurück</span></a></div>
