<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DesignThix</RootNamespace>
    <AssemblyName>DesignThix</AssemblyName>
    <UserSecretsId>designthix</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Draws the QR code of the authenticator app set-up as SVG (pure managed, no external service) -->
    <PackageReference Include="QRCoder" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesignThix.Core\DesignThix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Demo\kaesetheke.json" LogicalName="DesignThix.Demo.kaesetheke.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesignThix.Tests" />
  </ItemGroup>

</Project>
