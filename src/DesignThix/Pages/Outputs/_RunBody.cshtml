@model DesignThix.Pages.Outputs.RunView
@*
    The run page: a bar (what is printed, progress, warnings, the buttons) and the pages. output.js loads the payload (a saved output: /api/outputs/{id}/payload; a single
    print: the values from sessionStorage, posted to /api/outputs/adhoc), renders every label with the engine and sets the paper size through an @page rule.
*@
<div class="dt-run" id="dt-run" data-state="loading" data-payload-url="@Model.PayloadUrl" data-output-id="@Model.OutputId" data-adhoc="@(Model.Adhoc ? "true" : "false")" data-back-href="@Model.BackHref">
    <header class="dt-run__bar" role="toolbar" aria-label="Serienausgabe">
        <div class="dt-run__info">
            <h1 class="dt-run__title" id="dt-run-title">@Model.Title</h1>
            <p class="dt-run__meta" id="dt-run-meta">Die Serienausgabe wird vorbereitet ...</p>
        </div>
        <div class="dt-run__progress">
            <div class="mat-meter mat-meter--sm" aria-hidden="true"><div class="mat-meter__fill" id="dt-run-meter"></div></div>
            <p class="dt-run__status" id="dt-run-status" role="status" aria-live="polite">Lade ...</p>
        </div>
        <div class="mat-btn-row mat-btn-row--plain dt-run__buttons">
            <button type="button" class="mat-btn mat-btn--primary" id="dt-run-print" disabled hidden>@Ui.ToolIcon("printer")<span>Drucken / Als PDF speichern</span></button>
            <a class="mat-btn mat-btn--primary" id="dt-run-download" href="#" download hidden>@Ui.Icon("download")<span>PNG-ZIP herunterladen</span></a>
            <a class="mat-btn mat-btn--secondary" id="dt-run-back" href="@Model.BackHref">@Ui.Icon("back")<span>Zurück</span></a>
        </div>
    </header>
    <div class="mat-alert mat-alert--warning dt-run__notes" id="dt-run-warnings" role="status" hidden>
        @Ui.Icon("alert")
        <div class="mat-alert__body"><strong id="dt-run-warnings-title">Hinweise</strong><ul class="mat-alert__list" id="dt-run-warnings-list"></ul></div>
    </div>
    <div class="mat-alert mat-alert--danger dt-run__notes" id="dt-run-error" role="alert" hidden>
        @Ui.Icon("x-circle")
        <div class="mat-alert__body" id="dt-run-error-text"></div>
    </div>
    <main class="dt-run__stage" id="dt-run-stage" aria-label="Vorschau der Serienausgabe">
        <div class="dt-run__thumbs" id="dt-run-thumbs" hidden></div>
        <div class="dt-run__pages" id="dt-pages"></div>
    </main>
</div>
