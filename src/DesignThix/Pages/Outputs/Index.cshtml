@page
@model DesignThix.Pages.Outputs.IndexModel

<link rel="stylesheet" href="~/css/designs.css" asp-append-version="true" />

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        @if (Model.CanEdit)
        {
            <a class="mat-btn mat-btn--primary" href="/Outputs/Create">@Ui.Icon("plus")<span>Neue Ausgabe</span></a>
        }
        else
        {
            <span class="mat-hint">Anlegen dürfen Gestalter und Administratoren. Du kannst vorhandene Ausgaben ausführen.</span>
        }
    </div>
</div>

<script src="~/js/dt-engine.js" asp-append-version="true"></script>
<script src="~/js/designs.js" asp-append-version="true"></script>
