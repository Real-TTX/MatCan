@model DesignThix.Pages.Outputs.OutputFormPage
@{
    var job = Model.Job;
    var isNew = job is null;
    var ro = !Model.CanEdit;
    // After a refused save the tab of the first error is open (the message must not hide in a tab nobody looks at).
    var firstError = ViewData.ModelState.Where(e => e.Value?.Errors.Count > 0).Select(e => e.Key).FirstOrDefault();
    var tab = Context.Request.Query["tab"].ToString() is { Length: > 0 } t && (t is "selection" or "layout" or "format")
        ? t
        : firstError switch
        {
            "Input.SelectedRowIds" or "Input.Copies" => "selection",
            "Input.SheetLayoutId" or "Input.StartPosition" => "layout",
            "Input.Dpi" or "Input.FileNamePattern" => "format",
            _ => "general",
        };
}

<link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />

@if (ro)
{
    <div class="mat-alert mat-alert--info" role="note">@Ui.Icon("info")<div class="mat-alert__body">Du darfst Serienausgaben nur ansehen und ausführen.</div></div>
}

@* One form for all four tabs: the script (outputs.js) keeps the count of labels, the table of rows and the preview of the sheet up to date while the person types. *@
<form class="mat-form" method="post" novalidate data-dt-output-form data-sheets="@Model.SheetsJson" data-design-url="/api/designs/" data-rows-url="/api/datalists/" data-readonly="@(ro ? "true" : "false")">
    <dt-summary />
    <fieldset class="dt-fieldset" disabled="@ro">
        <legend class="mat-sr-only">Serienausgabe</legend>
        <dt-tabs id="output-tabs" label="Bereiche der Serienausgabe" selected="@tab">
            <dt-tab id="general" title="Allgemein" icon="settings">
                <dt-card title="Die Serienausgabe" icon="file-text">
                    <div class="mat-form__grid">
                        <dt-input for="Input.Name" label="Name" required="true" autocomplete="off" full="true" hint="Zum Beispiel: Käsetheke Herbst, Wochenangebote." />
                        <dt-select for="Input.DesignId" label="Design" required="true" items="Model.DesignItems" empty="Design wählen ..." full="true" />
                        <dt-select for="Input.DataListId" label="Datenliste" items="Model.ListItems" empty="Keine: die Beispielwerte des Designs drucken" full="true"
                                   hint="Eine Zeile der Liste ergibt ein Etikett. Ohne Liste druckt die Serienausgabe die Beispielwerte des Designs so oft, wie du bei „Kopien“ einträgst." />
                    </div>
                </dt-card>
            </dt-tab>

            <dt-tab id="selection" title="Auswahl" icon="list-checks">
                <p class="mat-muted" data-show-if="Input.DataListId" data-show-value="">Ohne Datenliste gibt es keine Zeilen zu wählen: die Serienausgabe druckt die Beispielwerte des Designs. Lege hier fest, wie viele Etiketten das sein sollen.</p>
                <div class="dt-stack" data-show-if="Input.DataListId">
                    <dt-card title="Welche Zeilen?" icon="table">
                        <div class="mat-form__grid">
                            <dt-radios for="Input.RowSelection" label="Zeilen der Datenliste" items="Model.SelectionItems" full="true" />
                        </div>
                    </dt-card>
                    <div data-show-if="Input.RowSelection" data-show-value="Selected">
                        <dt-card title="Ausgewählte Zeilen" icon="list-checks">
                            <input type="hidden" asp-for="Input.SelectedRowIds" data-dt-selected />
                            <div class="dt-rowpick" data-dt-rowpick aria-busy="true"></div>
                            <span class="mat-error" aria-live="polite">@Html.ValidationMessage("Input.SelectedRowIds")</span>
                        </dt-card>
                    </div>
                </div>
                <dt-card title="Kopien" icon="copy">
                    <div class="mat-form__grid">
                        <dt-input for="Input.Copies" label="Kopien der ganzen Auswahl" type="number" min="1" max="999" inputmode="numeric" hint="Jede Zeile wird so oft gedruckt, wie in ihrer Spalte „Kopien“ steht, und das noch einmal so oft, wie du hier einträgst." />
                    </div>
                    <div class="mat-alert mat-alert--info dt-count" role="status" aria-live="polite" data-dt-count>@Ui.Icon("info")<div class="mat-alert__body" data-dt-count-text></div></div>
                </dt-card>
            </dt-tab>

            <dt-tab id="layout" title="Layout" icon="grid">
                <div class="mat-alert mat-alert--info" data-show-if="Input.Format" data-show-value="Png">@Ui.Icon("info")<div class="mat-alert__body">Bei PNG-Bildern gibt es keinen Druckbogen: jedes Etikett wird eine eigene Datei in der Größe des Designs. Wähle auf dem Reiter „Format“ „Drucken oder als PDF speichern“, wenn du einen Druckbogen brauchst.</div></div>
                <div class="dt-stack" data-show-if="Input.Format" data-show-value="Print">
                    <dt-card title="Wie wird gedruckt?" icon="file">
                        <div class="mat-form__grid">
                            <dt-radios for="Input.Mode" label="Anordnung" items="Model.ModeItems" full="true" />
                        </div>
                    </dt-card>
                    <div class="dt-split dt-split--half" data-show-if="Input.Mode" data-show-value="Sheet">
                        <div class="dt-stack">
                            <dt-card title="Druckbogen" icon="dt:tags">
                                <div class="mat-form__grid">
                                    <dt-select for="Input.SheetLayoutId" label="Druckbogen" items="Model.SheetItems" empty="Druckbogen wählen ..." full="true" hint="Die Druckbögen verwaltest du unter Serien (Zusatz) → Druckbögen." />
                                    <dt-input for="Input.StartPosition" label="Startposition (Nummer des ersten Etiketts)" type="number" min="1" inputmode="numeric" hint="Ist der Bogen schon halb benutzt? Dann beginne beim ersten freien Etikett: die Plätze davor bleiben leer." />
                                    <dt-switch for="Input.CropMarks" label="Schnittmarken drucken" full="true" hint="Kleine Linien außerhalb jedes Etiketts zeigen, wo geschnitten wird." />
                                    <dt-radios for="Input.Scale" label="Ist das Design größer als das Etikett?" items="Model.ScaleItems" full="true" />
                                </div>
                                <div class="mat-alert mat-alert--warning dt-scalewarn" role="status" aria-live="polite" data-dt-scalewarn hidden>@Ui.Icon("alert")<div class="mat-alert__body" data-dt-scalewarn-text></div></div>
                            </dt-card>
                        </div>
                        <dt-card title="Vorschau" icon="eye">
                            <div class="dt-sheetpreview" data-dt-sheet-preview aria-label="Vorschau des Druckbogens"></div>
                            <p class="mat-hint" data-dt-sheet-info aria-live="polite"></p>
                        </dt-card>
                    </div>
                </div>
            </dt-tab>

            <dt-tab id="format" title="Format" icon="download">
                <dt-card title="Ausgabeformat" icon="download">
                    <div class="mat-form__grid">
                        <dt-radios for="Input.Format" label="Was soll herauskommen?" items="Model.FormatItems" full="true" />
                        <dt-input for="Input.Dpi" label="Auflösung (dpi)" type="number" min="72" max="600" inputmode="numeric" show-if="Input.Format" show-value="Png" hint="72 bis 600. Vorgabe ist die Auflösung des Designs: 300 dpi machen aus 150 × 100 mm ein Bild von 1772 × 1181 Pixeln." />
                        <dt-input for="Input.FileNamePattern" label="Dateinamen" show-if="Input.Format" show-value="Png" full="true" autocomplete="off" maxlength="200"
                                  hint="Mit Platzhaltern in geschweiften Klammern: {Design}, {Nr} (laufende Nummer), {Kopie} und die Schlüssel der Felder, zum Beispiel {Design}-{Nr}-{Name}. Die Endung .png kommt von selbst." />
                    </div>
                </dt-card>
            </dt-tab>
        </dt-tabs>
    </fieldset>

    @if (ro)
    {
        <dt-buttons no-save="true" back-href="/Outputs">
            <a class="mat-btn mat-btn--primary" href="/Outputs/@job!.Id/Run">@Ui.Icon("play")<span>Ausführen</span></a>
        </dt-buttons>
    }
    else if (isNew)
    {
        <dt-buttons save-text="Anlegen" save-icon="plus" back-href="/Outputs" />
    }
    else
    {
        <dt-buttons back-href="/Outputs" delete-url="@Url.Page("/Outputs/Edit", "Delete", new { id = job!.Id })" delete-confirm="Diese Serienausgabe löschen? Das Design und die Datenliste bleiben, wie sie sind.">
            <button type="submit" formnovalidate asp-page-handler="Run" asp-route-id="@job!.Id" class="mat-btn mat-btn--secondary dt-btn-run">@Ui.Icon("play")<span>Ausführen</span></button>
        </dt-buttons>
    }
</form>

<script src="~/js/outputs.js" asp-append-version="true"></script>
