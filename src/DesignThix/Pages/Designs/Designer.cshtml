@page "/Designs/{id:long}/Designer"
@model DesignThix.Pages.Designs.DesignerModel
@{
    Layout = "_Designer";
    var d = Model.Design;
    var edit = Model.CanEdit;
    // somebody who may only look gets "Kopie erstellen", which asks where the copy goes (the dialog of the file browser: its style sheet and scripts are only loaded for them)
    ViewData["Styles"] = edit ? new[] { "/css/designer.css", "/css/dt-media.css", "/css/ai.css" } : new[] { "/css/designer.css", "/css/dt-media.css", "/css/ai.css", "/css/browser.css" };
    var back = $"/Designs/Edit/{d.Id}";
}

@* The frame of the editor. Everything inside (rail, panels, toolbar, page strip, canvas) is built by designer*.js with DOM APIs; the document comes from /api/designs/{id}.
   Top bar | rail + panel | toolbar above the canvas, canvas, page strip and zoom below. Phones: the rail becomes the tab bar at the bottom and the panel a bottom sheet. *@
<div class="dt-ds is-loading" id="dt-ds" data-design-id="@d.Id" data-can-edit="@(edit ? "true" : "false")" data-back-href="@back" data-ai="@(Model.AiVisible ? "true" : "false")"
     data-output-href="/Outputs/Create?designId=@d.Id" data-name="@d.Name" data-brand-href="@Model.BrandHref">

    <header class="dt-top" role="banner">
        <a class="mat-btn mat-btn--ghost mat-btn--icon dt-top__back" href="/" id="dt-back" aria-label="Zurück zur Startseite" title="Zurück zur Startseite" data-leave>@Ui.ToolIcon("arrow-left")</a>
        <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm dt-top__file" id="dt-file" aria-haspopup="menu" aria-expanded="false"><span>Datei</span>@Ui.ToolIcon("chevron-down")</button>
        <span class="dt-top__group" role="group" aria-label="Verlauf">
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="dt-undo" aria-label="Rückgängig (Strg+Z)" title="Rückgängig (Strg+Z)" disabled>@Ui.ToolIcon("undo-2")</button>
            <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon" id="dt-redo" aria-label="Wiederholen (Strg+Y)" title="Wiederholen (Strg+Y)" disabled>@Ui.ToolIcon("redo-2")</button>
        </span>
        <span class="dt-top__state" id="dt-state" data-state="saved" role="status" aria-live="polite">
            @Ui.Icon("check-circle", "dt-top__state-icon")<span class="dt-top__state-text" id="dt-state-text">Alle Änderungen gespeichert</span>
        </span>

        <span class="dt-top__center">
            <label class="mat-sr-only" for="dt-name">Name des Designs</label>
            <input class="dt-top__name" id="dt-name" type="text" value="@d.Name" maxlength="200" autocomplete="off" spellcheck="false" readonly="@(!edit)" title="Klicken, um das Design umzubenennen" />
        </span>

        <span class="dt-top__people" id="dt-people" role="group" aria-label="Personen mit Zugriff" hidden></span>
        <a class="mat-btn mat-btn--secondary mat-btn--sm dt-top__series" href="/Outputs/Create?designId=@d.Id" id="dt-series" title="Serie: dieses Design mit einer Datenliste für viele Etiketten ausgeben (Zusatz)" data-leave>@Ui.ToolIcon("database")<span>Serie</span></a>
        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm dt-top__download" id="dt-download" title="Herunterladen: PNG, JPG, SVG oder PDF">@Ui.ToolIcon("download")<span>Herunterladen</span></button>
        <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon dt-top__print" id="dt-print" aria-label="Drucken" title="Drucken">@Ui.ToolIcon("printer")</button>
        @if (edit)
        {
            <button type="button" class="mat-btn mat-btn--primary mat-btn--sm dt-top__share" id="dt-share" title="Teilen: Personen einladen oder einen Link weitergeben" aria-haspopup="dialog">@Ui.ToolIcon("share-2")<span>Teilen</span></button>
        }
        else
        {
            <button type="button" class="mat-btn mat-btn--primary mat-btn--sm dt-top__copy" id="dt-copy" title="Kopie erstellen: eine eigene Kopie, die du bearbeiten kannst" aria-haspopup="dialog">@Ui.ToolIcon("copy-plus")<span>Kopie erstellen</span></button>
        }
    </header>

    <div class="dt-ds__body">
        <nav class="dt-rail" id="dt-rail" aria-label="Bereiche"></nav>

        <aside class="dt-panel" id="dt-panel" aria-label="Bereich" hidden>
            <header class="dt-panel__head">
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm dt-panel__back" id="dt-panel-back" aria-label="Zurück" title="Zurück" hidden>@Ui.ToolIcon("arrow-left")</button>
                <h2 class="dt-panel__title" id="dt-panel-title"></h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm dt-panel__close" id="dt-panel-close" aria-label="Bereich schließen" title="Bereich schließen">@Ui.ToolIcon("panel-left-close")</button>
            </header>
            <div class="dt-panel__body" id="dt-panel-body"></div>
        </aside>

        <div class="dt-ds__center" id="dt-center">
            <div class="dt-ctx" id="dt-ctx"></div>

            <div class="dt-ds__stage">
                <main class="dt-ds__canvas" id="dt-viewport" tabindex="0" aria-label="Zeichenfläche">
                    <div class="dt-stage" id="dt-stage">
                        <div class="dt-sheet" id="dt-sheet">
                            <div class="dt-page" id="dt-page"></div>
                            <svg class="dt-overlay" id="dt-overlay" aria-hidden="true" focusable="false"></svg>
                        </div>
                    </div>
                </main>
                <div class="dt-dropzone" id="dt-dropzone" hidden aria-hidden="true">@Ui.ToolIcon("cloud-upload")<strong>Zum Hochladen loslassen</strong><span>Bilder, Schriften</span></div>
                <div class="dt-loading" id="dt-loading" role="status"><span class="mat-spinner" aria-hidden="true"></span><span>Design wird geladen ...</span></div>
                <div class="dt-warnbar dt-canvas-tools" id="dt-warnbar" hidden role="status"></div>
            </div>

            <div class="dt-bottom" id="dt-bottom">
                <div class="dt-bottom__pages">
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm dt-bottom__fold" id="dt-pages-toggle" aria-expanded="true" aria-label="Seitenleiste ausblenden" title="Seitenleiste ausblenden">@Ui.ToolIcon("chevrons-up-down")</button>
                    <div class="dt-pages" id="dt-pages" role="tablist" aria-label="Seiten"></div>
                </div>
                <div class="dt-zoombar" id="dt-zoombar" role="group" aria-label="Zoom">
                    <span class="dt-zoombar__pages" id="dt-pagecount" aria-label="Seite"></span>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="dt-zoom-out" aria-label="Verkleinern (−)" title="Verkleinern (−)">@Ui.ToolIcon("zoom-out")</button>
                    <label class="mat-sr-only" for="dt-zoom">Zoomstufe</label>
                    <input type="range" class="dt-range dt-zoombar__range" id="dt-zoom" min="10" max="400" step="1" value="100" />
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="dt-zoom-in" aria-label="Vergrößern (+)" title="Vergrößern (+)">@Ui.ToolIcon("zoom-in")</button>
                    <button type="button" class="dt-zoombar__percent" id="dt-zoom-percent" title="Zoomstufe wählen" aria-haspopup="menu">100 %</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="dt-zoom-fit" aria-label="Einpassen (Strg+0)" title="Einpassen (Strg+0)">@Ui.ToolIcon("scan")</button>
                    <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" id="dt-snap" aria-label="Einrasten" aria-pressed="true" title="Einrasten an Rändern, Mitte und anderen Elementen (Alt beim Ziehen schaltet aus)">@Ui.ToolIcon("magnet")</button>
                </div>
            </div>
        </div>
    </div>

    <nav class="dt-tabbar" id="dt-tabbar" aria-label="Bereiche">
        <button type="button" class="dt-tabbar__btn" data-panel="elements" aria-pressed="false">@Ui.ToolIcon("shapes")<span>Elemente</span></button>
        <button type="button" class="dt-tabbar__btn" data-panel="text" aria-pressed="false">@Ui.ToolIcon("type")<span>Text</span></button>
        <button type="button" class="dt-tabbar__btn" data-panel="uploads" aria-pressed="false">@Ui.ToolIcon("cloud-upload")<span>Uploads</span></button>
        <button type="button" class="dt-tabbar__btn" data-panel="layers" aria-pressed="false">@Ui.ToolIcon("layers")<span>Ebenen</span></button>
        <button type="button" class="dt-tabbar__btn" id="dt-tabbar-more" aria-haspopup="menu" aria-expanded="false">@Ui.ToolIcon("ellipsis")<span>Mehr</span></button>
    </nav>
</div>

@section Scripts {
    <script src="~/js/dt-engine.js" asp-append-version="true"></script>
    <script src="~/js/ai.js" asp-append-version="true"></script>
    <script src="~/js/dt-media.js" asp-append-version="true"></script>
    <script src="~/js/designer.core.js" asp-append-version="true"></script>
    <script src="~/js/designer.canvas.js" asp-append-version="true"></script>
    <script src="~/js/designer.menu.js" asp-append-version="true"></script>
    <script src="~/js/designer.ui.js" asp-append-version="true"></script>
    <script src="~/js/designer.colors.js" asp-append-version="true"></script>
    <script src="~/js/designer.gradient.js" asp-append-version="true"></script>
    <script src="~/js/designer.commands.js" asp-append-version="true"></script>
    <script src="~/js/designer.toolbar-parts.js" asp-append-version="true"></script>
    <script src="~/js/designer.crop.js" asp-append-version="true"></script>
    <script src="~/js/designer.toolbar.js" asp-append-version="true"></script>
    <script src="~/js/designer.panels.js" asp-append-version="true"></script>
    <script src="~/js/designer.icons-de.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-elements.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-text.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-templates.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-uploads.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-layers.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-data.js" asp-append-version="true"></script>
    <script src="~/js/designer.panel-position.js" asp-append-version="true"></script>
    <script src="~/js/designer.effects.js" asp-append-version="true"></script>
    <script src="~/js/designer.pages.js" asp-append-version="true"></script>
    <script src="~/js/designer.io.js" asp-append-version="true"></script>
    <script src="~/js/designer.save.js" asp-append-version="true"></script>
    <script src="~/js/designer.file.js" asp-append-version="true"></script>
    <script src="~/js/share.js" asp-append-version="true"></script>
    @if (!edit)
    {
        <script src="~/js/dt-ui.js" asp-append-version="true"></script>
        <script src="~/js/movepicker.js" asp-append-version="true"></script>
    }
    <script src="~/js/designer.share.js" asp-append-version="true"></script>
    <script src="~/js/designer.shortcuts.js" asp-append-version="true"></script>
    <script src="~/js/designer.js" asp-append-version="true"></script>
}
