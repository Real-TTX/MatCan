@page "/Designs/{id:long}/Print"
@model DesignThix.Pages.Designs.PrintModel
@{
    var d = Model.Design;
    var imageHintShown = false;
}

<link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/datalist.css" asp-append-version="true" />

@* The form is made of the fields of the design. outputs.js keeps the preview up to date, collects the values and opens the run page (Outputs/Run) with them. *@
<form class="mat-form" novalidate data-dt-print-form data-design-id="@d.Id" data-design-url="/api/designs/@d.Id" data-sheets="@Model.SheetsJson" data-dpi="@Model.Dpi" data-assets-url="/api/assets" data-media-url="/media/">
    <div class="dt-split">
        <div class="dt-stack">
            <dt-card title="Werte" icon="edit" sub="@(Model.Fields.Count == 1 ? "1 Feld" : Model.Fields.Count + " Felder")">
                @if (Model.Fields.Count == 0)
                {
                    <p class="mat-muted">Dieses Design hat keine Felder: es wird so gedruckt, wie es ist. Felder legst du im Designer an.</p>
                }
                else
                {
                    <div class="mat-form__grid">
                        @foreach (var f in Model.Fields)
                        {
                            var name = "v." + f.Key;
                            var hint = f.Type == "price" ? "Zum Beispiel 2,99" : null;
                            if (f.Type == "multiline")
                            {
                                <dt-textarea name="@name" label="@f.Label" value="@f.Sample" rows="3" full="true" data-dt-field="@f.Key" />
                            }
                            else if (f.Type == "image")
                            {
                                var id = "v_" + f.Key;
                                <div class="mat-field mat-field--full">
                                    <label class="mat-label" for="@id">@f.Label</label>
                                    <div class="dt-imagefield" data-dt-imagefield data-label="@f.Label" data-category="@f.Category">
                                        <span class="dt-thumb dt-thumb--sm"><img alt="" data-dt-imagefield-img hidden /></span>
                                        <input class="mat-input mat-mono" type="text" id="@id" name="@name" value="@f.Sample" autocomplete="off" spellcheck="false" maxlength="80" data-dt-field="@f.Key" />
                                        <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-dt-pick>@Ui.Icon("image")<span>Medium wählen</span></button>
                                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-dt-clear>@Ui.Icon("x")<span>Leeren</span></button>
                                    </div>
                                    @if (!imageHintShown)
                                    {
                                        imageHintShown = true;
                                        <span class="mat-hint">Bilder sind Medien: der Schlüssel steht im Feld (zum Beispiel flag-de), „Medium wählen“ öffnet die Bibliothek.</span>
                                    }
                                </div>
                            }
                            else if (f.Type is "number" or "price")
                            {
                                <dt-input name="@name" label="@f.Label" value="@f.Sample" inputmode="decimal" autocomplete="off" hint="@hint" data-dt-field="@f.Key" />
                            }
                            else
                            {
                                <dt-input name="@name" label="@f.Label" value="@f.Sample" autocomplete="off" full="true" data-dt-field="@f.Key" />
                            }
                        }
                    </div>
                }
            </dt-card>

            <dt-card title="Ausgabe" icon="grid">
                <div class="mat-form__grid">
                    <dt-input name="copies" label="Kopien" value="1" type="number" min="1" max="999" inputmode="numeric" hint="So viele gleiche Etiketten werden gedruckt." />
                    <dt-input name="dpi" label="Auflösung für PNG (dpi)" value="@Model.Dpi.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="72" max="600" inputmode="numeric" hint="Nur für „PNG“." />
                    <dt-radios name="mode" label="Anordnung beim Drucken" items="Model.ModeItems" value="single" full="true" />
                    <dt-select name="sheet" label="Druckbogen" items="Model.SheetItems" empty="Druckbogen wählen ..." show-if="mode" show-value="sheet" full="true" />
                    <dt-input name="start" label="Startposition (Nummer des ersten Etiketts)" value="1" type="number" min="1" inputmode="numeric" show-if="mode" show-value="sheet" hint="Ein halb benutzter Bogen: beginne beim ersten freien Etikett." />
                    <dt-switch name="crop" label="Schnittmarken drucken" show-if="mode" show-value="sheet" full="true" />
                    <dt-radios name="scale" label="Ist das Design größer als das Etikett?" items="Model.ScaleItems" value="fit" show-if="mode" show-value="sheet" full="true" />
                </div>
                <div class="mat-alert mat-alert--warning dt-scalewarn" role="status" aria-live="polite" data-dt-scalewarn hidden>@Ui.Icon("alert")<div class="mat-alert__body" data-dt-scalewarn-text></div></div>
            </dt-card>
        </div>

        <aside class="dt-stack">
            <dt-card title="Vorschau" icon="eye">
                <div class="dt-printpreview" data-dt-print-preview aria-label="Vorschau des Etiketts"><span class="mat-spinner" aria-hidden="true"></span></div>
                <p class="mat-hint" data-dt-print-warn aria-live="polite"></p>
            </dt-card>
            <dt-card title="Druckbogen" icon="dt:tags" show-if="mode" show-value="sheet">
                <div class="dt-sheetpreview" data-dt-sheet-preview aria-label="Vorschau des Druckbogens"></div>
                <p class="mat-hint" data-dt-sheet-info aria-live="polite"></p>
            </dt-card>
        </aside>
    </div>

    <dt-buttons no-save="true" back-href="/Designs/Edit/@d.Id">
        <button type="button" class="mat-btn mat-btn--primary" data-dt-run="print">@Ui.ToolIcon("printer")<span>Drucken</span></button>
        <button type="button" class="mat-btn mat-btn--secondary dt-btn-run" data-dt-run="png">@Ui.Icon("download")<span>PNG</span></button>
    </dt-buttons>
</form>

<script src="~/js/dt-engine.js" asp-append-version="true"></script>
<script src="~/js/datalist.js" asp-append-version="true"></script>
<script src="~/js/outputs.js" asp-append-version="true"></script>
