@page
@model DesignThix.Pages.Designs.CreateModel

<form class="mat-form" method="post" novalidate>
    <dt-summary />
    <dt-card title="Das Design" icon="layers">
        <div class="mat-form__grid">
            <dt-input for="Input.Name" label="Name" required="true" autocomplete="off" full="true" />
            <div class="mat-field mat-field--full">
                <label class="mat-label" for="Input_Category">Kategorie</label>
                <input class="mat-input" type="text" id="Input_Category" name="Input.Category" value="@Model.Input.Category" list="design-categories" maxlength="80" autocomplete="off" />
                <datalist id="design-categories">
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
                <span class="mat-hint">Hilft beim Finden, zum Beispiel „Käsetheke“ oder „Schaufenster“. Du kannst eine vorhandene wählen oder eine neue tippen.</span>
            </div>
        </div>
    </dt-card>

    <dt-card title="Wie soll das Design starten?" icon="template">
        <div class="mat-form__grid">
            <dt-radios for="Input.Start" label="Start" items="Model.StartItems" full="true" />

            <dt-select for="Input.PresetKey" label="Format" items="Model.Presets" show-if="Input.Start" show-value="format" full="true" hint="Die Größe kannst du später im Designer ändern." />
            <dt-input for="Input.Width" label="Breite" type="number" inputmode="decimal" min="1" show-if="Input.PresetKey" show-value="custom" />
            <dt-input for="Input.Height" label="Höhe" type="number" inputmode="decimal" min="1" show-if="Input.PresetKey" show-value="custom" />
            <dt-select for="Input.Unit" label="Einheit" items="Model.Units" show-if="Input.PresetKey" show-value="custom" hint="Millimeter für Druck, Pixel für Bildschirm und soziale Medien." />

            @if (Model.Templates.Count > 0)
            {
                <dt-select for="Input.TemplateId" label="Vorlage" items="Model.Templates" empty="Bitte wählen ..." show-if="Input.Start" show-value="template" full="true" hint="Das Design wird mit allem, was drin ist, kopiert. Die Vorlage bleibt unverändert." />
            }
            else
            {
                <p class="mat-hint mat-field--full" data-show-if="Input.Start" data-show-value="template">Es gibt noch keine Vorlagen: markiere ein Design in seinen Eigenschaften als Vorlage.</p>
            }
        </div>
    </dt-card>

    <dt-buttons save-text="Design anlegen" save-icon="plus" back-href="/Designs" />
</form>
