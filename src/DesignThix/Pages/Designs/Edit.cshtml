@page "{id:long}"
@model DesignThix.Pages.Designs.EditModel
@{
    var d = Model.Design;
    var ro = !Model.CanEdit;
    var selected = Model.Tab is "fields" or "history" ? Model.Tab : "general";
}

<link rel="stylesheet" href="~/css/designs.css" asp-append-version="true" />

@if (ro)
{
    <div class="mat-alert mat-alert--info" role="note">@Ui.Icon("info")<div class="mat-alert__body">Du darfst Designs nur ansehen. Ändern können Gestalter und Administratoren.</div></div>
}

<form class="mat-form" method="post" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <dt-summary />
    <div class="dt-split">
        <div class="dt-designedit__main">
            <dt-tabs id="design-tabs" label="Bereiche des Designs" selected="@selected">
                <dt-tab id="general" title="Allgemein" icon="settings">
                    <div class="mat-form__grid">
                        <dt-input for="Input.Name" label="Name" required="true" readonly="@ro" autocomplete="off" full="true" />
                        <div class="mat-field mat-field--full">
                            <label class="mat-label" for="Input_Category">Kategorie</label>
                            <input class="mat-input" type="text" id="Input_Category" name="Input.Category" value="@Model.Input.Category" list="design-categories" maxlength="80" autocomplete="off" readonly="@ro" />
                            <datalist id="design-categories">
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c"></option>
                                }
                            </datalist>
                            <span class="mat-hint">Hilft beim Finden. Du kannst eine vorhandene Kategorie wählen oder eine neue tippen.</span>
                        </div>
                        <dt-textarea for="Input.Description" label="Beschreibung" rows="3" readonly="@ro" full="true" />
                        <dt-switch for="Input.IsTemplate" label="Als Vorlage anbieten" disabled="@ro" full="true" hint="Eine Vorlage erscheint im Menü unter „Vorlagen“ und in „Design erstellen“ unter „Aus Vorlage“. Neue Designs sind Kopien von ihr." />
                    </div>
                </dt-tab>
                <dt-tab id="fields" title="Felder" icon="list" count="@Model.Fields.Count">
                    @if (Model.Fields.Count == 0)
                    {
                        <p class="mat-muted">Dieses Design hat keine Felder. Im Designer legst du Felder an und setzt sie als Platzhalter wie <span class="mat-mono">{{Name}}</span> in Texte oder an Bilder.</p>
                    }
                    else
                    {
                        <div class="mat-table-wrap">
                            <table class="mat-table" id="design-fields">
                                <caption class="mat-sr-only">Felder des Designs</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Schlüssel</th>
                                        <th scope="col">Bezeichnung</th>
                                        <th scope="col" class="mat-hide-sm">Art</th>
                                        <th scope="col" class="mat-hide-sm">Beispielwert</th>
                                        <th scope="col">Verwendet in</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var f in Model.Fields)
                                    {
                                        <tr>
                                            <td data-label="Schlüssel" class="mat-mono">@f.Key</td>
                                            <td data-label="Bezeichnung">@(f.Defined ? f.Label : "")</td>
                                            <td data-label="Art" class="mat-hide-sm">@(f.Defined ? Designs.EditModel.TypeLabel(f.Type) : "")</td>
                                            <td data-label="Beispielwert" class="mat-hide-sm dt-break">@f.Sample</td>
                                            <td data-label="Verwendet in">
                                                @if (!f.Defined)
                                                {
                                                    <div>@Ui.Pill("nicht als Feld angelegt", "warn", "alert")</div>
                                                }
                                                @if (f.Uses.Count == 0)
                                                {
                                                    <span class="mat-muted">noch nirgends</span>
                                                }
                                                else
                                                {
                                                    <ul class="dt-plainlist">
                                                        @foreach (var use in f.Uses)
                                                        {
                                                            <li>@use</li>
                                                        }
                                                    </ul>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </dt-tab>
                <dt-tab id="history" title="Verlauf" icon="clock" count="@Model.Revisions.Count">
                    @if (Model.Revisions.Count == 0)
                    {
                        <p class="mat-muted">Es gibt noch keine gespeicherten Stände.</p>
                    }
                    else
                    {
                        <div class="mat-table-wrap">
                            <table class="mat-table" id="design-history">
                                <caption class="mat-sr-only">Gespeicherte Stände des Designs</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Stand</th>
                                        <th scope="col">Gespeichert</th>
                                        <th scope="col" class="mat-hide-sm">Von</th>
                                        @if (!ro)
                                        {
                                            <th scope="col"><span class="mat-sr-only">Aktionen</span></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.Revisions)
                                    {
                                        <tr>
                                            <td data-label="Stand">Stand @r.Revision @if (r.Revision == d.Revision) { @Ui.Pill("aktuell", "ok") }</td>
                                            <td data-label="Gespeichert">@Fmt.Moment(r.Date)</td>
                                            <td data-label="Von" class="mat-hide-sm">@(r.UserName ?? "–")</td>
                                            @if (!ro)
                                            {
                                                <td class="mat-table__cell-actions">
                                                    @if (r.Revision != d.Revision)
                                                    {
                                                        <button type="submit" formnovalidate asp-page-handler="Restore" asp-route-id="@Model.Id" asp-route-revision="@r.Revision" class="mat-btn mat-btn--secondary mat-btn--sm" data-confirm="Stand @r.Revision wiederherstellen? Der aktuelle Stand bleibt im Verlauf erhalten." data-confirm-ok="Wiederherstellen">@Ui.Icon("restore")<span>Wiederherstellen</span></button>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="mat-hint">Die letzten @DesignLogic.KeptRevisions Stände bleiben erhalten. Beim Wiederherstellen entsteht ein neuer Stand, nichts geht verloren.</p>
                    }
                </dt-tab>
            </dt-tabs>
        </div>

        <aside class="dt-designedit__aside">
            <dt-card title="Vorschau" icon="eye">
                <div class="dt-designpreview">@LibraryUi.DesignThumb(d)</div>
                <dl class="mat-kv">
                    <dt>Größe</dt><dd>@d.Size</dd>
                    <dt>Stand</dt><dd>@d.Revision</dd>
                    <dt>Zuletzt geändert</dt><dd>@Fmt.Moment(d.UpdateDate)</dd>
                </dl>
            </dt-card>
        </aside>
    </div>

    @if (ro)
    {
        <dt-buttons no-save="true" back-href="/Designs">
            <a class="mat-btn mat-btn--secondary" href="/Designs/@Model.Id/Designer">@Ui.Icon("edit")<span>Im Designer ansehen</span></a>
            <a class="mat-btn mat-btn--secondary" href="/Designs/@Model.Id/Print">@Ui.ToolIcon("printer")<span>Einzeldruck</span></a>
        </dt-buttons>
    }
    else
    {
        <dt-buttons back-href="/Designs" delete-url="@Url.Page("/Designs/Edit", "Delete", new { id = Model.Id })" delete-confirm="Dieses Design löschen? Serienausgaben, die es nutzen, können danach nicht mehr laufen.">
            <a class="mat-btn mat-btn--secondary" href="/Designs/@Model.Id/Designer">@Ui.Icon("edit")<span>Im Designer öffnen</span></a>
            <button type="submit" formnovalidate asp-page-handler="Duplicate" asp-route-id="@Model.Id" class="mat-btn mat-btn--secondary">@Ui.Icon("copy")<span>Duplizieren</span></button>
            <a class="mat-btn mat-btn--secondary" href="/Designs/@Model.Id/Print">@Ui.ToolIcon("printer")<span>Einzeldruck</span></a>
            <a class="mat-btn mat-btn--secondary" href="@Url.Page("/Designs/Edit", "Export", new { id = Model.Id })" download>@Ui.Icon("download")<span>Exportieren</span></a>
        </dt-buttons>
    }
</form>

<script src="~/js/dt-engine.js" asp-append-version="true"></script>
<script src="~/js/designs.js" asp-append-version="true"></script>
