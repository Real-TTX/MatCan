@page
@model DesignThix.Pages.DataLists.IndexModel

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        @if (Model.CanEdit)
        {
            <a class="mat-btn mat-btn--primary" href="/DataLists/Edit">@Ui.Icon("plus")<span>Neue Datenliste</span></a>
        }
        else
        {
            <span class="mat-hint">Anlegen dürfen Gestalter und Administratoren.</span>
        }
    </div>
</div>
