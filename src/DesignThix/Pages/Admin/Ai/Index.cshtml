@page
@model DesignThix.Pages.Admin.Ai.IndexModel
@{
    var u = Model.Usage;
}

<div class="mat-grid dt-stats">
    @Ui.Kpi("Tokens heute", Fmt.Integer(u.TodayTokens), $"{u.TodayRuns} Läufe", "sparkles", href: "/Admin/Ai/Runs")
    @Ui.Kpi("Tokens im Monat", Fmt.Integer(u.MonthTokens), Model.Input.MonthlyTokens > 0 ? $"von {Fmt.Integer(Model.Input.MonthlyTokens)}" : "ohne Grenze", "bar-chart", href: "/Admin/Ai/Runs", bad: Model.Input.MonthlyTokens > 0 && u.MonthTokens > Model.Input.MonthlyTokens * 0.8)
    @Ui.Kpi("Läufe im Monat", Fmt.Integer(u.MonthRuns), null, "activity", href: "/Admin/Ai/Runs")
</div>

<form class="mat-form" method="post" novalidate>
    <dt-summary />
    <dt-tabs id="ai-tabs" label="Bereiche der KI">
        <dt-tab id="general" title="Allgemein" icon="sparkles">
            <dt-card title="KI in DesignThix" icon="sparkles">
                <div class="mat-form__grid">
                    <dt-switch for="Input.Enabled" label="KI eingeschaltet" full="true" />
                </div>
                <p class="mat-hint">Ohne KI funktioniert alles andere wie gewohnt; die KI-Knöpfe fehlen dann nur.
                    Verbindungen richtest du unter <a href="/Admin/Ai/Profiles">Profile</a> ein@(Model.RelayConfigured ? "; ohne aktives Profil läuft die KI über das Relay des Betreibers" : "").</p>
            </dt-card>
        </dt-tab>
        <dt-tab id="instructions" title="Anweisungen" icon="file-text">
            <dt-card title="Grundanweisung der Website" icon="file-text" sub="Die zweite Schicht. Leer heißt: der eingebaute Standardtext.">
                <div class="mat-form__grid">
                    <dt-textarea for="Input.BaseInstruction" label="Grundanweisung" rows="8" full="true" placeholder="@AiInstructions.DefaultBase"
                                 hint="Ton, Zuständigkeiten, was die KI nie sagen soll. Das Antwortformat und die Regeln sind fest und hier nicht änderbar." />
                </div>
            </dt-card>
            <dt-card title="Wie die Anweisung aufgebaut ist" icon="layers">
                <ol class="dt-steps">
                    <li><strong>Vorgabe des Betreibers</strong> und je Aktion eine Ergänzung (aus der Konfiguration des Servers)@(string.IsNullOrWhiteSpace(Model.OperatorInstruction) ? ": zurzeit leer" : "").</li>
                    <li><strong>Grundanweisung der Website</strong>: das Feld oben.</li>
                    <li><strong>Fester Teil</strong>: Antwortformat (ein JSON-Objekt), Regeln. Niemand kann ihn bearbeiten.</li>
                    <li><strong>Die Lage</strong>: das Design, die Datenliste, die Eingaben.</li>
                </ol>
                @foreach (var (action, text) in Model.Preview)
                {
                    <details class="dt-details">
                        <summary>Vollständige Anweisung anzeigen: @Labels.Of(action)</summary>
                        <pre class="dt-code dt-code--wrap">@text</pre>
                    </details>
                }
            </dt-card>
        </dt-tab>
        <dt-tab id="privacy" title="Datenschutz" icon="shield">
            <dt-card title="Personenbezogene Daten" icon="shield">
                <div class="mat-form__grid">
                    <dt-switch for="Input.SendPersonalData" label="Personenbezogene Daten an die KI senden" full="true" />
                </div>
                <p class="mat-hint">Aus: Datenlisten, die als „enthält personenbezogene Daten“ markiert sind, lehnt die KI ab. Welche Daten die KI überhaupt sieht, entscheidet der Code, nie das Modell:
                    sie bekommt nur, was für die gewählte Aktion nötig ist.</p>
                <p class="mat-hint">Empfohlen ist ein Anbieter in der EU, zum Beispiel Mistral. Anbieter in den USA oder China bedeuten eine Übermittlung in ein Drittland, die in die Datenschutzerklärung gehört (für China gibt es keinen Angemessenheitsbeschluss).</p>
            </dt-card>
        </dt-tab>
        <dt-tab id="limits" title="Grenzen" icon="sliders">
            <dt-card title="Kosten und Missbrauch begrenzen" icon="sliders" sub="Geprüft, bevor gerufen wird. 0 heißt: keine Grenze.">
                <div class="mat-form__grid">
                    <dt-input for="Input.UserDailyTokens" label="Tokens pro Benutzer und Tag" type="number" min="0" step="1000" />
                    <dt-input for="Input.MonthlyTokens" label="Tokens pro Monat (alle zusammen)" type="number" min="0" step="10000" />
                    <dt-input for="Input.AddressDailyRuns" label="Aufrufe pro Adresse und Tag" type="number" min="0" step="1" hint="Die Adresse zählt als täglich wechselnder Hash, nie im Klartext." />
                    <dt-input for="Input.PerMinutePerAddress" label="Anfragen pro Adresse und Minute" type="number" min="0" step="1" />
                    <dt-input for="Input.MaxTokens" label="Längenlimit einer Antwort (Tokens)" type="number" min="1000" max="64000" step="1000" hint="Großzügig lassen: denkende Modelle verbrauchen ihr Budget zuerst fürs Nachdenken." />
                    <dt-input for="Input.TimeoutSeconds" label="Zeitlimit (Sekunden)" type="number" min="30" max="600" step="10" />
                </div>
                <p class="mat-hint">Nennt ein Anbieter keine Tokenzahl, wird geschätzt (Zeichen geteilt durch 4).</p>
            </dt-card>
        </dt-tab>
    </dt-tabs>
    <dt-buttons back-href="/Admin/Ai/Profiles" back-text="Zu den Profilen" />
</form>
