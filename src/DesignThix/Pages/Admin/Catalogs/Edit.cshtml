@page
@model DesignThix.Pages.Admin.Catalogs.EditModel
@using DesignThix.Catalogs
@{
    var c = Model.Row.Catalog;
    var external = c.Caps.HasFlag(CatalogCaps.External);
    var needsKey = c.Caps.HasFlag(CatalogCaps.NeedsKey);
    var limited = external;
}

<form class="mat-form" method="post" asp-page-handler="" novalidate data-catalog-edit="@c.Id">
    <input type="hidden" name="Id" value="@Model.Id" />
    <dt-summary />
    <dt-card title="Katalog" icon="dt:images">
        <div class="mat-form__grid">
            <dt-switch for="Input.Enabled" label="Eingeschaltet" full="true" hint="@(external ? "Aus: Niemand sieht den Katalog, und der Server fragt den Anbieter nicht." : "Aus: Der Katalog ist nirgends zu sehen.")" />
            <dt-input for="Input.Order" label="Reihenfolge" type="number" min="-1000" max="1000" step="1" inputmode="numeric" hint="Kleine Zahlen stehen vorn bei den Reitern." />
        </div>
        <dl class="mat-kv">
            <dt>Inhalt</dt><dd>@c.Info.Description</dd>
            <dt>Lizenz</dt><dd>@c.Info.LicenceSummary</dd>
            @if (!string.IsNullOrEmpty(c.Info.Homepage) && c.Info.Homepage.StartsWith("https://", StringComparison.Ordinal))
            {
                <dt>Anbieter</dt><dd><a href="@c.Info.Homepage" target="_blank" rel="noopener noreferrer">@c.Info.Homepage</a></dd>
            }
        </dl>
        @if (Model.BaseUrlNote is { } note) { <p class="mat-hint">@note</p> }
    </dt-card>

    @if (c.Info.Rules is { Count: > 0 } rules)
    {
        <dt-card title="Regeln und Grenzen des Anbieters" icon="shield">
            <ul class="dt-steps" data-catalog-rules>
                @foreach (var rule in rules)
                {
                    <li>@rule</li>
                }
            </ul>
            @if (Model.RateNote is { } rate) { <p class="mat-hint" data-catalog-rate>@rate</p> }
        </dt-card>
    }

    @if (c.HotlinkHosts.Count > 0)
    {
        <dt-card title="Datenschutz: Vorschaubilder direkt vom Anbieter" icon="shield">
            <p data-catalog-privacy>Wenn @c.Name eingeschaltet ist, lädt dein Browser die Vorschaubilder direkt von @c.Name. @c.Name sieht dabei deine IP-Adresse und welche Fotos du dir ansiehst.</p>
            <p class="mat-hint" data-catalog-csp>Dafür erlaubt DesignThix in der Content-Security-Policy der Seiten für angemeldete Personen, die den Medienbrowser oder den Editor zeigen (Designer, Einzeldruck, Marke, Datenliste), Bilder von @string.Join(", ", c.HotlinkHosts) und von nichts sonst. Die öffentliche Ansicht, die Anmeldung und alle anderen Seiten bleiben unverändert, und ist der Katalog ausgeschaltet oder ohne Schlüssel, ist die Richtlinie so streng wie vorher. Ein Foto, das jemand benutzt, liegt danach auf diesem Server: Drucken, Herunterladen und die öffentliche Ansicht laden nie etwas von @c.Name. Erwähne die Vorschaubilder in deiner Datenschutzerklärung.</p>
        </dt-card>
    }

    @if (needsKey || (external && c.Info.KeyLabel != ""))
    {
        <dt-card title="Schlüssel" icon="key">
            <div class="mat-form__grid">
                <dt-input for="Input.Key" label="@(c.Info.KeyLabel ?? "Schlüssel des Anbieters")" type="password" autocomplete="off" full="true"
                          hint="@(Model.Row.HasKey ? "Ein Schlüssel ist gespeichert (verschlüsselt, nie wieder sichtbar). Leer lassen, um ihn zu behalten." : "Wird verschlüsselt im Datenvolume gespeichert – nie in der Datenbank, nie in einem Backup, nie im Browser.")" />
                @if (Model.Row.HasKey)
                {
                    <dt-switch for="Input.RemoveKey" label="Gespeicherten Schlüssel entfernen" full="true" />
                }
            </div>
            @if (c.Info.KeyHint is { } keyHint) { <p class="mat-hint" data-catalog-keyhint>@keyHint</p> }
            @if (c.Info.KeyHelpUrl is { } help && help.StartsWith("https://", StringComparison.Ordinal))
            {
                <p class="mat-hint">Einen Schlüssel bekommst du hier: <a href="@help" target="_blank" rel="noopener noreferrer">@help</a></p>
            }
        </dt-card>
    }

    @if (limited)
    {
        <dt-card title="Grenzen und Filter" icon="shield">
            <div class="mat-form__grid">
                <dt-input for="Input.PerUserPerMinute" label="Suchen pro Person und Minute" type="number" min="0" max="1000" step="1" inputmode="numeric" hint="@($"0 = Standard ({c.Info.DefaultPerUserPerMinute}).")" />
                <dt-input for="Input.PerHour" label="Anfragen pro Stunde (alle zusammen)" type="number" min="0" max="100000" step="1" inputmode="numeric" hint="@(c.Info.DefaultPerHour > 0 ? $"0 = Standard ({c.Info.DefaultPerHour}), so viele erlaubt der Anbieter dem Schlüssel." : "0 = keine Grenze von DesignThix.")" />
                @if (c.Info.HasSafeSearch)
                {
                    <dt-switch for="Input.SafeSearch" label="Nur jugendfreie Bilder (Safe Search)" full="true" />
                }
                else
                {
                    <input type="hidden" name="Input.SafeSearch" value="true" />
                }
                @if (c.Info.HasLicenceChoice)
                {
                    <dt-textarea for="Input.AllowedLicences" label="Erlaubte Lizenzen" rows="3" full="true" hint="Eine pro Zeile, zum Beispiel CC0, CC-BY oder CC-BY-SA. Leer: die Standardlizenzen des Katalogs. Lizenzen mit NC oder ND sind nie möglich." />
                }
                @if (c.Info.SetChoiceLabel is { } setLabel)
                {
                    <dt-textarea for="Input.Sets" label="@setLabel" rows="4" full="true" hint="@c.Info.SetChoiceHint" />
                }
            </div>
        </dt-card>
    }
    else
    {
        <input type="hidden" name="Input.SafeSearch" value="true" />
    }

    @if (Model.IsFolder)
    {
        <dt-card title="Ordner auf dem Server" icon="hard-drive">
            <div class="mat-form__grid">
                <dt-textarea for="Input.Folders" label="Namen der Ordner" rows="4" full="true" hint="Einer pro Zeile. Es sind Ordner im Datenvolume unter catalogs/ (im Container /data/catalogs); Unterordner sind die Sammlungen. Nur Namen, keine Pfade." />
            </div>
            <p class="mat-hint">Die Bilder bleiben, wo sie sind: DesignThix liest sie nur und kopiert ein Bild erst in die Bibliothek, wenn jemand es benutzt. Verknüpfungen (Symlinks) werden nie verfolgt.</p>
            <p class="mat-hint" data-folders-on-disk>@(Model.FoldersOnDisk.Count == 0 ? "Im Moment liegt noch kein Ordner unter catalogs/. Lege einen an (oder binde ein Volume ein) und trage seinen Namen hier ein." : "Gefunden unter catalogs/: " + string.Join(", ", Model.FoldersOnDisk))</p>
        </dt-card>
    }

    <dt-buttons back-href="/Admin/Catalogs" back-text="Zu den Katalogen">
        <button type="submit" formaction="@Url.Page("/Admin/Catalogs/Edit", "Test", new { id = Model.Id })" formnovalidate class="mat-btn mat-btn--secondary" data-catalog-test>@Ui.Icon("play")<span>Testen</span></button>
    </dt-buttons>
</form>
