@page "/Einladung/{token:guid}"
@model DesignThix.Pages.Account.InviteModel
@{
    Layout = "_Bare";
    var p = Model.Preview;
    var who = string.IsNullOrWhiteSpace(p.InviterName) ? "Jemand" : p.InviterName;
}

<div class="mat-auth__card" data-invitation-status="@p.Status">
    @if (p.Status != InviteStatus.Valid)
    {
        <div class="mat-auth__brand">
            @Ui.Logo("lg")
            <h1>Diese Einladung gilt nicht mehr</h1>
            <p class="mat-muted">@InviteLogic.Problem(p.Status)</p>
        </div>
        <div class="mat-btn-row mat-btn-row--plain">
            <a class="mat-btn mat-btn--secondary mat-btn--block" href="@(Model.SignedIn ? "/" : "/Account/Login")">@Ui.Icon(Model.SignedIn ? "home" : "login")<span>@(Model.SignedIn ? "Zur Startseite" : "Zur Anmeldung")</span></a>
        </div>
    }
    else
    {
        <div class="mat-auth__brand">
            @Ui.Logo("lg")
            <h1>@(p.TeamName is null ? "Einladung zu DesignThix" : "Einladung ins Team „" + p.TeamName + "“")</h1>
            <p class="mat-muted">@who hat dich @(p.TeamName is null ? "zu DesignThix" : "als " + Labels.Of(p.Role) + " ins Team") eingeladen. Die Einladung gilt bis @Fmt.Date(p.Expires).</p>
        </div>

        @if (Model.WrongAddress)
        {
            <div class="mat-alert mat-alert--warning" role="alert">@Ui.Icon("alert")<div class="mat-alert__body">Diese Einladung gilt für <strong>@p.Email</strong>. Du bist mit <strong>@Model.MyEmail</strong> angemeldet. Melde dich mit der eingeladenen Adresse an.</div></div>
            <form method="post" action="/Account/Logout" asp-antiforgery="true" class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--secondary mat-btn--block">@Ui.Icon("logout")<span>Abmelden</span></button>
            </form>
        }
        else if (Model.SignedIn)
        {
            <form method="post" asp-antiforgery="true" class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block" data-accept-invitation>@Ui.Icon("check")<span>Einladung annehmen</span></button>
            </form>
        }
        else
        {
            <div class="mat-btn-row mat-btn-row--plain dt-invite-choice">
                <a class="mat-btn mat-btn--primary mat-btn--block" href="/Account/Register?invitation=@Model.Token.ToString("D")" data-invite-register>@Ui.Icon("plus")<span>Konto erstellen</span></a>
                <a class="mat-btn mat-btn--secondary mat-btn--block" href="/Account/Login?returnUrl=/Einladung/@Model.Token.ToString("D")" data-invite-login>@Ui.Icon("login")<span>Ich habe schon ein Konto: Anmelden</span></a>
            </div>
            @if (!string.IsNullOrEmpty(p.Email))
            {
                <p class="mat-hint">Die Einladung gilt für @p.Email.</p>
            }
        }
    }
</div>
