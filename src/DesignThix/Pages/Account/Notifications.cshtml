@page
@model DesignThix.Pages.Account.NotificationsModel
@{
    ViewData["Styles"] = new[] { "/css/notify.css" };
    var items = Model.Notifications.Items;
}

<div class="mat-list" data-notifications-page>
    <div class="dt-notifbar">
        <p class="mat-hint" role="status">@(Model.Notifications.Unread == 0 ? "Alles gelesen." : $"{Ui.Plural(Model.Notifications.Unread, "ungelesene Benachrichtigung", "ungelesene Benachrichtigungen")}.")</p>
        <form method="post" asp-page-handler="ReadAll">
            <button type="submit" class="mat-btn mat-btn--secondary" disabled="@(Model.Notifications.Unread == 0)">@Ui.Icon("check")<span>Alle als gelesen markieren</span></button>
        </form>
    </div>

    @if (items.Count == 0)
    {
        <div class="mat-empty" data-notifications-empty>
            <span class="mat-empty__icon">@Ui.Icon("bell")</span>
            <div class="mat-empty__title">Keine Benachrichtigungen</div>
            <p>Wenn jemand etwas mit dir teilt, Zugriff anfragt oder dich in ein Team holt, steht es hier.</p>
        </div>
    }
    else
    {
        <ul class="dt-notiflist" aria-label="Benachrichtigungen">
            @foreach (var n in items)
            {
                <li class="dt-notif @(n.IsRead ? "" : "is-unread")" data-notification="@n.Id" data-kind="@n.Kind">
                    <span class="dt-notif__icon">@Ui.Icon(n.Icon)</span>
                    <div class="dt-notif__body">
                        <a class="dt-notif__text" href="/Account/Notifications?handler=Open&amp;id=@n.Id">@n.Text</a>
                        @if (!string.IsNullOrEmpty(n.Message))
                        {
                            <q class="dt-notif__message">@n.Message</q>
                        }
                        <span class="dt-notif__time">@Fmt.Ago(n.Created, Model.Now)</span>
                        @if (n.RequestId is { } requestId && n.RequestState == "open")
                        {
                            <form method="post" asp-page-handler="Decide" class="dt-notif__actions">
                                <input type="hidden" name="requestId" value="@requestId" />
                                <button type="submit" name="grant" value="true" class="mat-btn mat-btn--primary mat-btn--sm">@Ui.Icon("check")<span>Gewähren</span></button>
                                <button type="submit" name="grant" value="false" class="mat-btn mat-btn--secondary mat-btn--sm">@Ui.Icon("x")<span>Ablehnen</span></button>
                            </form>
                        }
                        else if (n.RequestId is not null && n.RequestState is "granted" or "declined")
                        {
                            <span class="dt-notif__state">@(n.RequestState == "granted" ? "Gewährt" : "Abgelehnt")</span>
                        }
                    </div>
                    @if (!n.IsRead)
                    {
                        <span class="dt-notif__dot" role="img" aria-label="ungelesen"></span>
                    }
                </li>
            }
        </ul>
        <partial name="_Pager" model="Model.Pager" />
    }
</div>
