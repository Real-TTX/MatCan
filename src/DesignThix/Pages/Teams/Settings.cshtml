@page "/Teams/{slug}/Einstellungen"
@model DesignThix.Pages.Teams.SettingsModel

<partial name="_TeamHeader" model="Model.Header" />

<form class="mat-form" method="post" novalidate>
    <dt-summary title="Bitte prüfe die Angaben." />
    <dt-card title="Team" icon="settings">
        <div class="mat-form__grid">
            <dt-input for="Input.Name" label="Name" required="true" autocomplete="off" maxlength="120" hint="Ändert sich der Name, ändert sich auch die Adresse des Teams." />
            <div class="mat-field">
                <label class="mat-label" for="Input_Color">Farbe</label>
                <div class="mat-picker" data-picker="colour" data-placeholder="Farbe wählen">
                    <input class="mat-picker__input" id="Input_Color" name="Input.Color" value="@Model.Input.Color" autocomplete="off" />
                </div>
            </div>
            <dt-textarea for="Input.Description" label="Beschreibung" rows="3" maxlength="500" full="true" />
        </div>
    </dt-card>
    <dt-buttons back-href="/Teams/@Model.Team.Slug/Projekte" />
</form>

@if (Model.IsOwner)
{
    <dt-card title="Inhaberschaft übergeben" icon="user">
        <p class="mat-hint">Eine andere Person aus dem Team wird Inhaber, du wirst Admin. Ein Team hat immer mindestens einen Inhaber.</p>
        @if (Model.OtherMembers.Count == 0)
        {
            <p class="mat-hint">Es gibt noch niemand anderen im Team. Lade zuerst jemanden ein.</p>
        }
        else
        {
            <form class="mat-form" method="post" asp-page-handler="Transfer" asp-route-slug="@Model.Team.Slug">
                <div class="mat-form__grid">
                    <div class="mat-field">
                        <label class="mat-label" for="NewOwnerId">Neuer Inhaber</label>
                        <select class="mat-select" id="NewOwnerId" name="NewOwnerId" required>
                            @foreach (var m in Model.OtherMembers)
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mat-actions"><button type="submit" class="mat-btn mat-btn--secondary" data-confirm="Die Inhaberschaft übergeben? Du wirst Admin im Team." data-confirm-ok="Übergeben">@Ui.Icon("user")<span>Inhaberschaft übergeben</span></button></div>
            </form>
        }
    </dt-card>

    <dt-card title="Team löschen" icon="trash" sub="nur Inhaber">
        <p class="mat-hint">Das Team verschwindet für alle. Sein Inhalt (Designs, Bilder, Datenlisten, Ordner) wird nach @Model.TrashDays Tagen endgültig gelöscht; bis dahin kommt niemand mehr heran. Freigaben an das Team enden. Willst du etwas behalten, verschiebe es vorher in deine Projekte.</p>
        <form class="mat-form" method="post" asp-page-handler="Delete" asp-route-slug="@Model.Team.Slug" data-delete-team>
            <div class="mat-form__grid">
                <div class="mat-field mat-field--full">
                    <label class="mat-label" for="ConfirmName">Zur Bestätigung den Namen des Teams eintippen</label>
                    <input class="mat-input" id="ConfirmName" name="ConfirmName" autocomplete="off" placeholder="@Model.Team.Name" data-confirm-name="@Model.Team.Name" />
                </div>
            </div>
            <div class="mat-actions"><button type="submit" class="mat-btn mat-btn--danger" data-delete-team-button disabled>@Ui.Icon("trash")<span>Team endgültig löschen</span></button></div>
        </form>
    </dt-card>
}

@section Scripts {
    <script src="~/js/teams.js" asp-append-version="true"></script>
}
