@page
@model DesignThix.Pages.Fonts.IndexModel

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_Table" model="Model.Table" />
    <partial name="_Pager" model="Model.Pager" />
    <div class="mat-actions">
        @if (Model.CanEdit)
        {
            <a class="mat-btn mat-btn--primary" href="/Fonts/Upload">@Ui.Icon("upload")<span>Schrift hochladen</span></a>
        }
        else
        {
            <span class="mat-hint">Hochladen dürfen Gestalter und Administratoren.</span>
        }
    </div>
</div>

<script src="~/js/library.js" asp-append-version="true"></script>
