@page
@using DesignThix.Core.Documents
@model DesignThix.Pages.IndexModel
@{
    ViewData["Robots"] = "noindex, nofollow";
    var searching = Model.Search is not null;
}

<link rel="stylesheet" href="~/css/designs.css" asp-append-version="true" />

<header class="dt-start__hero">
    <p class="dt-start__hello">Guten Tag, @Model.Greeting.</p>
    <h1 class="dt-start__title">Was möchtest du heute gestalten?</h1>
    @if (Model.AiDesign)
    {
        <partial name="_AiPrompt" model='("start-ai", "hero")' />
    }
    <form class="dt-start__search" method="get" action="/" role="search">
        <div class="mat-input-icon">
            @Ui.Icon("search")
            <input class="mat-input" type="search" id="start-q" name="q" value="@Model.Q" placeholder="Designs, Ordner, Vorlagen und mehr suchen" aria-label="Suchen" autocomplete="off" enterkeyhint="search" maxlength="100" />
        </div>
        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("search")<span>Suchen</span></button>
    </form>
</header>

@if (searching)
{
    var found = Model.Search!;
    <section class="dt-section" aria-labelledby="start-results" data-search-results>
        <div class="dt-section__head">
            <h2 class="dt-section__title" id="start-results">@(Model.NothingFound ? "Nichts gefunden" : "Gefunden für „" + found.Text + "“")</h2>
            <a class="dt-section__more" href="/">Suche zurücksetzen</a>
        </div>
        @if (Model.NothingFound)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@Ui.Icon("search")</span>
                <div class="mat-empty__title">Nichts passt zu „@found.Text“</div>
                <p>Die Suche schaut in die Namen deiner Designs, Ordner, Datenlisten, Serienausgaben und Bilder und in Name, Kategorie und Beschreibung der Vorlagen. Versuche einen kürzeren Begriff.</p>
            </div>
        }
    </section>
    @if (Model.FoundView is { } foundView)
    {
        <section class="dt-section" aria-labelledby="start-found-items">
            <div class="dt-section__head"><h2 class="dt-section__title" id="start-found-items">Deine Projekte</h2></div>
            <partial name="_Browser" model="foundView" />
        </section>
    }
    @if (found.Templates.Count > 0)
    {
        <section class="dt-section" aria-labelledby="start-found-templates">
            <div class="dt-section__head"><h2 class="dt-section__title" id="start-found-templates">Vorlagen <span class="dt-category__count">@found.Templates.Count</span></h2><a class="dt-section__more" href="/Templates?q=@Uri.EscapeDataString(found.Text)">In den Vorlagen ansehen</a></div>
            <div class="dt-tplgrid" data-found-templates>
                @foreach (var t in found.Templates)
                {
                    <partial name="_TemplateTile" model="(t, true, Model.Manageable.Contains(t.Id))" />
                }
            </div>
        </section>
    }
}
else
{
    @if (Model.CanEdit)
    {
        <section class="dt-section" aria-labelledby="start-formats">
            <div class="dt-section__head"><h2 class="dt-section__title" id="start-formats">Design erstellen</h2></div>
            <partial name="_FormatTiles" model="(FormatPresets.Tiles, true)" />
        </section>
    }

    @if (Model.Templates.Count > 0)
    {
        <section class="dt-section" aria-labelledby="start-templates">
            <div class="dt-section__head">
                <h2 class="dt-section__title" id="start-templates">Vorlagen</h2>
                <a class="dt-section__more" href="/Templates">Alle Vorlagen</a>
            </div>
            <div class="dt-tilerow" data-start-templates>
                @foreach (var t in Model.Templates)
                {
                    <partial name="_TemplateTile" model="(t, true, false)" />
                }
            </div>
        </section>
    }

    <section class="dt-section" aria-labelledby="start-recent">
        <div class="dt-section__head">
            <h2 class="dt-section__title" id="start-recent">Zuletzt verwendet</h2>
            <a class="dt-section__more" href="/Projekte">Alle Projekte</a>
        </div>
        <partial name="_Browser" model="Model.RecentView!" />
    </section>

    @if (Model.RecentOutputs.Count > 0)
    {
        <section class="dt-series" aria-labelledby="start-series">
            <h2 class="dt-series__title" id="start-series">Serien (Zusatz): zuletzt ausgeführt</h2>
            <ul class="dt-notes" data-recent-outputs>
                @foreach (var o in Model.RecentOutputs)
                {
                    <li class="dt-note">
                        <span class="dt-note__icon dt-note__icon--info">@Ui.Icon(o.Format == OutputFormat.Png ? "image" : "download")</span>
                        <div class="dt-note__body">
                            <a class="dt-note__title" href="/Outputs/Edit/@o.Id">@o.Name</a>
                            <span class="dt-note__meta">@(o.DesignName ?? "Design gelöscht")@(o.DataListName is null ? "" : " · " + o.DataListName) · @(o.LastRunDate is null ? "noch nie ausgeführt" : "ausgeführt " + Fmt.Ago(o.LastRunDate.Value, DateTime.UtcNow))</span>
                        </div>
                        <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Outputs/@o.Id/Run" aria-label="@o.Name ausführen">@Ui.Icon("play")<span>Ausführen</span></a>
                    </li>
                }
            </ul>
        </section>
    }
}

<ul class="dt-facts" aria-label="Zahlen">
    <li><a class="dt-fact" href="/Designs"><strong>@Fmt.Integer(Model.Counts.Designs)</strong> @(Model.Counts.Designs == 1 ? "Design" : "Designs")</a></li>
    <li><a class="dt-fact" href="/Templates"><strong>@Fmt.Integer(Model.Counts.Templates)</strong> @(Model.Counts.Templates == 1 ? "Vorlage" : "Vorlagen")</a></li>
    <li><a class="dt-fact" href="/Assets"><strong>@Fmt.Integer(Model.Counts.Assets)</strong> @(Model.Counts.Assets == 1 ? "Bild" : "Bilder")</a></li>
    <li><a class="dt-fact" href="/Fonts"><strong>@Fmt.Integer(Model.Counts.Fonts)</strong> @(Model.Counts.Fonts == 1 ? "Schrift" : "Schriften")</a></li>
    <li><a class="dt-fact" href="/DataLists"><strong>@Fmt.Integer(Model.Counts.DataLists)</strong> @(Model.Counts.DataLists == 1 ? "Datenliste" : "Datenlisten")</a></li>
    <li><a class="dt-fact" href="/Outputs"><strong>@Fmt.Integer(Model.OutputCount)</strong> @(Model.OutputCount == 1 ? "Serienausgabe" : "Serienausgaben")</a></li>
    @if (Model.Facts is { } f)
    {
        <li><a class="dt-fact" href="/Admin/Users"><strong>@Fmt.Integer(f.Users)</strong> @(f.Users == 1 ? "Benutzer" : "Benutzer")</a></li>
        <li><a class="dt-fact" href="/Admin/Ai/Runs"><strong>@Fmt.Integer(f.AiRuns)</strong> @(f.AiRuns == 1 ? "KI-Lauf" : "KI-Läufe")</a></li>
    }
</ul>

@section Scripts {
    <partial name="_BrowserScripts" />
}
