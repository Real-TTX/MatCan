@inject IconSprite Sprite
@inject ShellFactory ShellFactory
@{
    // The layout of the run page (Outputs/Run): no menu, no breadcrumb, no footer. On the screen a compact bar and the pages as they will come out; when printing only
    // the pages (output.css hides the bar and sets the size of the paper through an @page rule that output.js inserts). Everything else of the app (theme, dialogs,
    // toasts) is as in _Layout.
    var shell = await ShellFactory.BuildAsync();
    var title = ViewData["Title"] as string ?? "Serienausgabe";
    ViewData["Styles"] = new[] { "/css/output.css" };
}
<!DOCTYPE html>
<html lang="de" data-app="designthix" data-sw="@(AppVersion.Current)-@(Sprite.Hash)" @Html.Raw(shell.RootAttributes) class="dt-print-page"
      data-dlg-ok="OK" data-dlg-cancel="Abbrechen" data-dlg-close="Schließen" data-dlg-confirm="Bitte bestätigen" data-dlg-notice="Hinweis" data-dlg-input="Eingabe"
      data-msg-required="Bitte fülle dieses Feld aus." data-msg-type="Bitte gib einen gültigen Wert ein." data-msg-pattern="Das Format stimmt nicht." data-copied="Kopiert">
<partial name="_Head" model="(shell, title)" />
<body class="dt-print-body">
    @Html.Raw(Sprite.Html)

    @RenderBody()

    @if (TempData["Flash"] is string flash)
    {
        <div data-toast="@flash" data-tone="success" hidden></div>
    }
    @if (TempData["Error"] is string error)
    {
        <div data-toast="@error" data-tone="error" hidden></div>
    }

    <script src="~/ui/matui.js?v=@Sprite.Hash"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
