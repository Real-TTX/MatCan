@page "{id:long}"
@model DesignThix.Pages.Assets.EditModel
@{
    var a = Model.Asset;
    var ro = !Model.CanEdit;
}

@if (ro)
{
    <div class="mat-alert mat-alert--info" role="note">@Ui.Icon("info")<div class="mat-alert__body">Du darfst Medien nur ansehen.</div></div>
}

<form class="mat-form" method="post" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="Tab" value="@Model.Tab" />
    <dt-summary />
    <dt-tabs id="asset-tabs" label="Bereiche des Mediums" selected="@Model.Tab">
        <dt-tab id="general" title="Allgemein" icon="image">
            <div class="dt-stack">
                <div class="dt-preview dt-preview--asset">
                    <img src="@a.Url" alt="Vorschau von @a.Name" />
                </div>
                <div class="mat-form__grid">
                    <dt-input for="Input.Key" label="Schlüssel" required="true" readonly="@ro" autocomplete="off" hint="So heißt das Bild in Datenlisten und im Designer (Kleinbuchstaben, Ziffern, - und _). Ändere ihn mit Bedacht: Verweise auf den alten Schlüssel zeigen dann kein Bild mehr." />
                    <dt-input for="Input.Name" label="Name" required="true" readonly="@ro" autocomplete="off" />
                    <dt-select for="Input.Category" label="Kategorie" items="Model.CategoryItems" disabled="@ro" />
                    <dt-input for="Input.Tags" label="Stichwörter" readonly="@ro" autocomplete="off" hint="Mit Komma getrennt. Die Suche findet das Bild auch über sie." />
                </div>
            </div>
        </dt-tab>
        <dt-tab id="file" title="Datei" icon="file">
            <dl class="mat-kv">
                <dt>Typ</dt><dd>@a.ContentType</dd>
                <dt>Dateigröße</dt><dd>@Fmt.FileSize(a.SizeBytes)</dd>
                <dt>Bildgröße</dt><dd>@(a.Width is { } w && a.Height is { } h ? $"{w} × {h} Pixel" : "unbekannt")</dd>
                <dt>Prüfsumme (SHA-256)</dt><dd class="mat-mono dt-break">@a.ContentHash</dd>
                <dt>Herkunft</dt><dd>@(a.IsBuiltIn ? "mitgeliefert (Flaggen und Siegel von DesignThix)" : "von dir hochgeladen")</dd>
                <dt>Zuletzt geändert</dt><dd>@Fmt.Moment(a.UpdateDate)</dd>
            </dl>
            <div class="mat-btn-row mat-btn-row--plain">
                <a class="mat-btn mat-btn--secondary" href="/media/@Uri.EscapeDataString(a.Key)?download=1">@Ui.Icon("download")<span>Herunterladen</span></a>
            </div>
            @if (!ro)
            {
                <h3 class="dt-subhead">Datei ersetzen</h3>
                <div class="mat-field">
                    <label class="mat-label" for="NewFile">Neue Datei</label>
                    <div class="mat-upload mat-upload--compact" data-upload data-max-size="12MB">
                        <input class="mat-upload__input" type="file" id="NewFile" name="NewFile" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,.png,.jpg,.jpeg,.webp,.gif,.svg" />
                    </div>
                    <span class="mat-hint">Der Schlüssel bleibt: Designs und Datenlisten zeigen danach die neue Datei. Sie wird mit Speichern ersetzt.</span>
                </div>
            }
        </dt-tab>
        <dt-tab id="usage" title="Verwendung" icon="link" count="@(Model.Usage.Designs.Count + Model.Usage.DataLists.Count)">
            <h3 class="dt-subhead">Designs</h3>
            @if (Model.Usage.Designs.Count == 0)
            {
                <p class="mat-muted">Kein Design nutzt dieses Bild.</p>
            }
            else
            {
                <ul class="dt-notes">
                    @foreach (var d in Model.Usage.Designs)
                    {
                        <li class="dt-note"><span class="dt-note__icon">@Ui.Icon("layers")</span><div class="dt-note__body"><a class="dt-note__title" href="/Designs/Edit/@d.Id">@d.Name</a>@if (!string.IsNullOrEmpty(d.Detail)) { <span class="dt-note__meta">@d.Detail</span> }</div></li>
                    }
                </ul>
            }
            <h3 class="dt-subhead">Datenlisten</h3>
            @if (Model.Usage.DataLists.Count == 0)
            {
                <p class="mat-muted">Keine Datenliste nutzt dieses Bild.</p>
            }
            else
            {
                <ul class="dt-notes">
                    @foreach (var l in Model.Usage.DataLists)
                    {
                        <li class="dt-note"><span class="dt-note__icon">@Ui.Icon("table")</span><div class="dt-note__body"><a class="dt-note__title" href="/DataLists/Edit/@l.Id?tab=rows">@l.Name</a></div></li>
                    }
                </ul>
            }
            <p class="mat-hint">Gesucht wird nach dem Schlüssel in den Dokumenten der Designs und in den Zeilen der Datenlisten.</p>
        </dt-tab>
    </dt-tabs>

    @if (!ro)
    {
        <dt-buttons back-href="/Assets" delete-url="@Url.Page("/Assets/Edit", "Delete", new { id = Model.Id })" delete-confirm="Dieses Medium löschen? Designs und Datenlisten, die seinen Schlüssel nutzen, zeigen dann kein Bild mehr." />
    }
    else
    {
        <dt-buttons no-save="true" back-href="/Assets" />
    }
</form>
